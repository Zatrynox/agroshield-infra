# Production web image: TLS termination, HSTS, ACME and the same same-origin
# routing as Caddyfile.
#
# Required environment:
#   SITE_ADDRESS  e.g. https://agroshield.example
#   ACME_EMAIL    contact address for the ACME account
#   API_UPSTREAM  backend:3000
#   LANDING_ROOT  /srv/landing
#   APP_ROOT      /srv/app
#
# The container listens on 8080 (HTTP / ACME) and 8443 (HTTPS) so it can run as
# an unprivileged user. Compose maps host 80 -> 8080 and 443 -> 8443.
{
	admin off
	persist_config off
	http_port 8080
	https_port 8443
	email {$ACME_EMAIL}

	servers {
		protocols h1 h2
	}
}

# Shared by every response, including errors. Site-level `header` directives
# are deferred, but they are not inherited by `handle_errors`, so the snippet is
# imported there too.
(agroshield_security) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self'"
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	import agroshield_security

	route {
		handle /healthz {
			respond "ok" 200
		}

		handle /api/* {
			uri strip_prefix /api
			header Cache-Control "no-store"
			reverse_proxy {$API_UPSTREAM:backend:3000}
		}

		# Keep the trailing slash so Vite's base path and the Vue Router history
		# base stay aligned, and preserve any query string.
		@appWithQuery {
			path /app
			expression {http.request.uri.query} != ""
		}
		redir @appWithQuery /app/?{http.request.uri.query} 308
		redir /app /app/ 308

		handle /app/assets/* {
			uri strip_prefix /app
			root * {$APP_ROOT:/srv/app}
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle /app/* {
			uri strip_prefix /app
			root * {$APP_ROOT:/srv/app}
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}

		handle /_astro/* {
			root * {$LANDING_ROOT:/srv/landing}
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			root * {$LANDING_ROOT:/srv/landing}
			header Cache-Control "no-cache"
			try_files {path} {path}/index.html {path}.html
			file_server
		}
	}

	handle_errors {
		import agroshield_security
		header Cache-Control "no-store"

		@landing404 {
			expression {http.error.status_code} == 404
			not path /api/*
		}
		rewrite @landing404 /404.html
		root * {$LANDING_ROOT:/srv/landing}
		file_server
	}
}
