# Production Compose environment template.
#
#   cp infra/env/prod.env.example infra/env/prod.env
#   chmod 600 infra/env/prod.env
#   # fill every empty value; then:
#   docker compose --env-file infra/env/prod.env -f compose.prod.yaml up -d --build
#
# Every empty required value makes Compose stop before building. Never commit
# infra/env/prod.env (it is gitignored).

# Public domain served by Caddy. No scheme here.
PROD_SITE_DOMAIN=

# ACME account contact. Use a monitored mailbox.
PROD_ACME_EMAIL=

# PostgreSQL. Generate a URL-safe password, for example:
#   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
PROD_POSTGRES_DB=agroshield
PROD_POSTGRES_USER=agroshield
PROD_POSTGRES_PASSWORD=

# Must match the credentials above. URL-encode special characters or use the
# URL-safe password generated above.
# Example shape: postgresql://agroshield:PASSWORD@db:5432/agroshield
PROD_DATABASE_URL=

# At least 32 characters, no placeholder words. Generate with:
#   openssl rand -hex 48
PROD_SESSION_SECRET=

# Optional public contact channels. Leave empty to hide the WhatsApp/email
# links on the landing.
PROD_SUPPORT_EMAIL=
PROD_WHATSAPP_NUMBER=

# Legal identity for the footer and legal pages. Compose refuses to build the
# production web image while these are empty.
PROD_LEGAL_ENTITY=
PROD_LEGAL_ADDRESS=
