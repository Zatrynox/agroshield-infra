# AgroShield - local host-native development example.
# Copy to .env. Never commit .env. Every value here is fake and demo-only.
#
# This file is read by `pnpm dev:api` and by Compose for variable interpolation.
# Docker Compose overrides DATABASE_URL/CORS_ORIGINS per service; the values
# below are for running the API directly on the host.

APP_ENV=development
NODE_ENV=development
DEMO_MODE=true

# Public URLs (no secrets). Host-native development defaults.
PUBLIC_SITE_NAME=AgroShield
PUBLIC_LANDING_URL=http://localhost:4321
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_DEMO_MODE=true

# API
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4321,http://127.0.0.1:4321,http://localhost:8080,http://127.0.0.1:8080
TRUST_PROXY=false
ENABLE_API_DOCS=true

# 32+ random characters. This value is fake and local-only. Production must use
# a fresh secret and never this string (the API rejects placeholders in prod).
SESSION_SECRET=local-only-session-secret-0123456789abcdef0123456789abcdef
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

# Host-native zero-dependency database. The Docker stacks use PostgreSQL 17 and
# pass their own DATABASE_URL; they ignore this value.
DATABASE_URL=pglite://.data/pglite
AUTO_MIGRATE=true

# Local PostgreSQL settings consumed by Compose (not by the host-native API).
POSTGRES_DB=agroshield
POSTGRES_USER=agroshield
POSTGRES_PASSWORD=local-only-db-password

# Demo only. The seed refuses to run when DEMO_MODE is not true or when
# NODE_ENV=production.
DEMO_PASSWORD=Demo-AgroShield-2026!
DEMO_SENSOR_KEY_DIR=./.data/demo-keys

# Captcha (built-in proof of work, no third-party key required)
CAPTCHA_DIFFICULTY=4
LEAD_RATE_LIMIT_PER_HOUR=5

# Simulator (local demo only)
SIMULATOR_INTERVAL_MS=15000
SIMULATOR_ONCE=false

# Production is configured separately, never here:
#   infra/env/prod.env.example -> infra/env/prod.env
#   docker compose --env-file infra/env/prod.env -f compose.prod.yaml up -d --build
